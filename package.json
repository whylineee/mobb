{
  "name": "agentwatch",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:server": "tsx scripts/build.ts --server-only",
    "dev": "tsx watch packages/daemon/src/cli.ts start --dev",
    "dev:web": "pnpm --filter @agentwatch/web dev",
    "agentwatch": "node packages/daemon/dist/cli.js",
    "test": "pnpm build:server && vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "format:check": "prettier --check packages scripts tests",
    "format": "prettier --write packages scripts tests"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.5",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "hono": "^4.13.14",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vitest": "5.0.5"
  }
}
